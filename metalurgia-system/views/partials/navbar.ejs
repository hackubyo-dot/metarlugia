<!-- ==================== HEADER PRINCIPAL ==================== -->
<header class="site-header" id="header">
    
    <!-- 1. TOPBAR (INFORMAÇÕES DE CONTATO E REDES SOCIAIS) -->
    <div class="topbar d-none d-lg-block">
        <div class="container-fluid px-4 px-xl-5">
            <div class="row align-items-center">
                <!-- Coluna de Informações -->
                <div class="col-md-7">
                    <div class="topbar-info">
                        <span>
                            <i class="fas fa-map-marker-alt"></i> 
                            Polo Industrial de Viana, Luanda
                        </span>
                        <span>
                            <i class="fas fa-envelope"></i> 
                            leonardodossantos006@gmail.com
                        </span>
                        <span>
                            <i class="fas fa-headset"></i> 
                            (+244) 939 717 295
                        </span>
                    </div>
                </div>
                
                <!-- Coluna de Ações e Social -->
                <div class="col-md-5 text-end">
                    <div class="topbar-actions">
                        <div class="topbar-social">
                            <a href="#" target="_blank" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" target="_blank" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                            <a href="#" target="_blank" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                            <a href="<%= helpers.whatsappLink('Olá, gostaria de saber mais sobre seus serviços.') %>" target="_blank" aria-label="WhatsApp">
                                <i class="fab fa-whatsapp"></i>
                            </a>
                        </div>
                        
                        <!-- Botão de Troca de Tema (Desktop) -->
                        <button class="theme-toggle" id="themeToggle" title="Alternar Tema">
                            <i class="fas fa-moon"></i>
                            <i class="fas fa-sun"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. NAVBAR (LOGO E MENU DE NAVEGAÇÃO) -->
    <nav class="navbar" id="navbar">
        <div class="container-fluid px-4 px-xl-5">
            <div class="navbar-container">
                
                <!-- Logo com link dinâmico -->
                <a href="/" class="logo">
                    <img src="/images/logo.png" alt="Metalurgia Futurística Logo" class="logo-img">
                </a>

                <!-- Menu Desktop (Centralizado via CSS) -->
                <div class="desktop-menu d-none d-xl-flex">
                    <a href="/#home" class="nav-link <%= helpers.isActive(currentPath, '/') %>">INÍCIO</a>
                    <a href="/#historia" class="nav-link">NOSSA HISTÓRIA</a>
                    <a href="/#servicos" class="nav-link">SERVIÇOS</a>
                    <a href="/#portfolio" class="nav-link">PORTFÓLIO</a>
                    <a href="/#download" class="nav-link">CATÁLOGO</a>
                    <a href="/blog" class="nav-link <%= helpers.isActive(currentPath, '/blog') %>">BLOG</a>
                    <a href="/#contacto" class="nav-link">CONTATO</a>
                </div>

                <!-- Ações da Navbar (Botão de Orçamento e Toggle Mobile) -->
                <div class="navbar-actions">
                    <!-- Botão de Orçamento (Escondido em telas muito pequenas) -->
                    <a href="/#contacto" class="btn-primary btn-sm d-none d-md-inline-flex">
                        SOLICITAR ORÇAMENTO
                        <i class="fas fa-arrow-right"></i>
                    </a>
                    
                    <!-- Botão Hambúrguer (Apenas Mobile/Tablet) -->
                    <button class="mobile-toggle d-xl-none" id="mobileToggle" aria-label="Abrir Menu">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                </div>

            </div>
        </div>
    </nav>
</header>

<script>
    /**
     * Script de ajuste de links dinâmicos.
     * Se o usuário estiver no blog, os links com '#' devem levar de volta para a Home.
     */
    (function() {
        const isHomePage = window.location.pathname === '/';
        const navLinks = document.querySelectorAll('.desktop-menu .nav-link, .logo');

        if (!isHomePage) {
            navLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (href && href.startsWith('#')) {
                    link.setAttribute('href', '/' + href);
                }
            });
        }
    })();
</script>