<script>
    /**
     * MÓDULO DE INTERAÇÃO DO MODAL (UI/UX)
     * Gerencia a barra de progresso, ano dinâmico e eventos de teclado.
     */
    (function() {
        document.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('serviceModal');
            const scrollBox = document.getElementById('modalDataScroll');
            const progressBar = document.getElementById('serviceScrollProgress');
            const yearSpan = document.querySelector('.current-year-modal');

            // Atualiza ano no rodapé do modal
            if (yearSpan) yearSpan.textContent = new Date().getFullYear();

            // Lógica do Reading Tracker (Barra de Progresso)
            if (scrollBox && progressBar) {
                scrollBox.addEventListener('scroll', () => {
                    const winScroll = scrollBox.scrollTop;
                    const height = scrollBox.scrollHeight - scrollBox.clientHeight;
                    const scrolled = (winScroll / height) * 100;
                    progressBar.style.width = scrolled + "%";
                });
            }

            // Atalho de acessibilidade: ESC para fechar
            document.addEventListener('keydown', (e) => {
                if (e.key === "Escape" && modal && modal.classList.contains('active')) {
                    if(typeof window.closeServiceModal === 'function') {
                        window.closeServiceModal();
                    }
                }
            });
        });
    })();
</script>
