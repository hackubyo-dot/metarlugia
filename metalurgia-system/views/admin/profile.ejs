<!-- 
    ADMIN/PROFILE.EJS - GESTÃO DE CONTA ADMINISTRATIVA
    Metalurgia Futurística Leonardo Serra 
-->

<div class="container-fluid p-0">

    <!-- Cabeçalho da Página -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold mb-1">Meu Perfil</h2>
            <p class="text-muted">Gerencie suas informações pessoais e configurações de segurança.</p>
        </div>
    </div>

    <div class="row g-4">
        
        <!-- Coluna da Esquerda: Dados Pessoais -->
        <div class="col-xl-8">
            <div class="card bg-dark-2 border-secondary shadow-sm mb-4">
                <div class="card-header bg-transparent border-secondary py-3">
                    <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-user-edit me-2"></i>Informações da Conta</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/admin/profile/update" method="POST" enctype="multipart/form-data">
                        
                        <!-- Upload de Avatar -->
                        <div class="d-flex align-items-center mb-5 gap-4">
                            <div class="profile-avatar-wrapper">
                                <img src="<%= user.avatar || '/images/logo.png' %>" alt="Avatar" id="profile_preview">
                                <label for="avatar_input" class="avatar-edit-btn" title="Trocar Foto">
                                    <i class="fas fa-camera"></i>
                                </label>
                                <input type="file" name="avatar_file" id="avatar_input" class="hidden" accept="image/*">
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-white">Foto de Perfil</h6>
                                <p class="small text-muted mb-0">Esta foto será exibida no dashboard e nos artigos do blog.</p>
                                <p class="small text-muted">Formatos aceitos: JPG, PNG, WEBP. Máx: 2MB.</p>
                            </div>
                        </div>

                        <div class="row g-4">
                            <!-- Nome Completo -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Nome de Exibição</label>
                                <input type="text" name="full_name" class="form-control bg-dark border-secondary text-white" 
                                       value="<%= user.name %>" required>
                                <div class="form-text text-muted">Como você será identificado no sistema.</div>
                            </div>

                            <!-- E-mail (Somente leitura para segurança, alteração via Supabase Auth) -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">E-mail de Acesso</label>
                                <input type="email" class="form-control bg-dark border-secondary text-muted" 
                                       value="<%= user.email %>" readonly>
                                <div class="form-text text-info"><i class="fas fa-info-circle me-1"></i> O e-mail não pode ser alterado por aqui.</div>
                            </div>

                            <!-- Cargo / Role -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Nível de Acesso</label>
                                <input type="text" class="form-control bg-dark border-secondary text-primary fw-bold" 
                                       value="<%= user.role.toUpperCase() %>" readonly>
                            </div>

                            <!-- Data de Entrada -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Membro desde</label>
                                <input type="text" class="form-control bg-dark border-secondary text-muted" 
                                       value="<%= helpers.formatDate(user.created_at) %>" readonly>
                            </div>

                            <!-- Botão de Salvar -->
                            <div class="col-12 pt-3">
                                <hr class="border-secondary mb-4">
                                <button type="submit" class="btn btn-primary px-5 fw-bold">
                                    <i class="fas fa-save me-2"></i> ATUALIZAR PERFIL
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Coluna da Direita: Segurança e Status -->
        <div class="col-xl-4">
            
            <!-- Card de Troca de Senha -->
            <div class="card bg-dark-2 border-secondary shadow-sm mb-4">
                <div class="card-header bg-transparent border-secondary py-3">
                    <h5 class="mb-0 fw-bold text-warning"><i class="fas fa-shield-alt me-2"></i>Segurança</h5>
                </div>
                <div class="card-body p-4">
                    <p class="small text-muted mb-4">Para sua segurança, recomendamos a troca de senha a cada 90 dias.</p>
                    
                    <form action="/auth/reset-password-request" method="POST">
                        <input type="hidden" name="email" value="<%= user.email %>">
                        <button type="submit" class="btn btn-dark border-secondary w-100 mb-3">
                            <i class="fas fa-key me-2"></i> SOLICITAR TROCA DE SENHA
                        </button>
                    </form>
                    
                    <div class="alert bg-warning bg-opacity-10 border-warning border-opacity-25 text-warning small mb-0">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        Um link de redefinição será enviado para o seu e-mail cadastrado.
                    </div>
                </div>
            </div>

            <!-- Card de Sessão Atual -->
            <div class="card bg-dark-2 border-secondary shadow-sm">
                <div class="card-header bg-transparent border-secondary py-3">
                    <h5 class="mb-0 fw-bold text-info"><i class="fas fa-history me-2"></i>Atividade Recente</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-3 border-bottom border-secondary pb-2">
                        <span class="small text-muted">Último Login:</span>
                        <span class="small text-white fw-bold"><%= helpers.formatDate(new Date()) %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom border-secondary pb-2">
                        <span class="small text-muted">IP de Acesso:</span>
                        <span class="small text-white fw-bold">Detectado via SSL</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="small text-muted">Navegador:</span>
                        <span class="small text-white fw-bold">Sistema Full Stack v1.0</span>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<style>
    /* Estilização do Avatar no Perfil */
    .profile-avatar-wrapper {
        position: relative;
        width: 120px;
        height: 120px;
    }

    .profile-avatar-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid var(--bg-dark-3);
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }

    .avatar-edit-btn {
        position: absolute;
        bottom: 5px;
        right: 5px;
        width: 35px;
        height: 35px;
        background: var(--primary);
        color: #000;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 3px solid var(--bg-dark-2);
        transition: all 0.3s;
    }

    .avatar-edit-btn:hover {
        transform: scale(1.1);
        background: var(--primary-dark);
    }

    .form-control[readonly] {
        cursor: not-allowed;
    }
</style>

<script>
    /**
     * Script de Preview do Avatar antes do Upload
     */
    document.addEventListener('DOMContentLoaded', () => {
        const avatarInput = document.getElementById('avatar_input');
        const profilePreview = document.getElementById('profile_preview');

        if (avatarInput) {
            avatarInput.addEventListener('change', function() {
                const file = this.files[0];
                if (file) {
                    // Validação de Tamanho (2MB)
                    if (file.size > 2 * 1024 * 1024) {
                        alert('A imagem é muito grande. O limite é de 2MB.');
                        this.value = '';
                        return;
                    }

                    const reader = new FileReader();
                    reader.onload = function(e) {
                        profilePreview.src = e.target.result;
                    }
                    reader.readAsDataURL(file);
                }
            });
        }
    });
</script>