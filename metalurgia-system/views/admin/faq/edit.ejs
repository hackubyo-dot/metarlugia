<!-- 
    ADMIN/FAQ/EDIT.EJS - ALTERAR PERGUNTA EXISTENTE
    Metalurgia Futurística Leonardo Serra 
-->

<div class="container-fluid p-0">

    <!-- Cabeçalho de Navegação -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/admin/faq" class="text-primary text-decoration-none">FAQ</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">Editar Pergunta</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0">Alterar Dúvida</h2>
        </div>
        <a href="/admin/faq" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i> VOLTAR
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8">
            <div class="card bg-dark-2 border-secondary shadow-sm">
                <div class="card-header bg-transparent border-secondary py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-edit me-2"></i>Editar Conteúdo</h5>
                    <span class="badge bg-dark border border-secondary text-muted">ID: <%= faq.id.substring(0,8) %></span>
                </div>
                <div class="card-body p-4">
                    <form action="/admin/faq/update/<%= faq.id %>" method="POST" id="faqEditForm">
                        
                        <div class="row g-4">
                            <!-- Pergunta Principal -->
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Pergunta do Cliente</label>
                                <input type="text" name="question" class="form-control bg-dark border-secondary text-white" 
                                       value="<%= faq.question %>" placeholder="Ex: Vocês oferecem garantia?" required>
                            </div>

                            <!-- Ordem de Exibição -->
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Ordem de Prioridade</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-primary"><i class="fas fa-sort-numeric-down"></i></span>
                                    <input type="number" name="display_order" class="form-control bg-dark border-secondary text-white" 
                                           value="<%= faq.display_order %>" min="1" required>
                                </div>
                                <div class="form-text text-muted">Ajuste a posição no site.</div>
                            </div>

                            <!-- Resposta Técnica -->
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Resposta Detalhada</label>
                                <textarea name="answer" class="form-control bg-dark border-secondary text-white" rows="8" 
                                          placeholder="Descreva a resposta técnica..." required><%= faq.answer %></textarea>
                            </div>

                            <!-- Botões de Ação -->
                            <div class="col-md-12 pt-4 border-top border-secondary mt-4">
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary px-5 py-2 fw-bold">
                                        <i class="fas fa-sync-alt me-2"></i> ATUALIZAR FAQ
                                    </button>
                                    <a href="/admin/faq" class="btn btn-outline-secondary px-4">CANCELAR</a>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>

            <!-- Card de Histórico -->
            <div class="card mt-4 bg-dark-3 border-secondary border-opacity-50">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center text-muted small">
                        <i class="fas fa-clock me-2"></i>
                        <span>Última atualização deste registro: <%= helpers.formatDate(faq.created_at) %></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<style>
    /* Consistência visual com o formulário de criação */
    .form-control:focus {
        border-color: var(--primary);
        box-shadow: 0 0 15px rgba(var(--primary-rgb), 0.1);
        background-color: var(--bg-dark-3) !important;
    }

    textarea.form-control {
        line-height: 1.7;
        resize: vertical;
    }

    .badge {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
</style>

<script>
    /**
     * Validação de segurança no frontend
     */
    document.getElementById('faqEditForm').addEventListener('submit', function(e) {
        const question = document.querySelector('input[name="question"]').value.trim();
        const answer = document.querySelector('textarea[name="answer"]').value.trim();

        if (question.length < 5 || answer.length < 10) {
            alert('Por favor, preencha a pergunta e a resposta com informações completas.');
            e.preventDefault();
        }
    });
</script>