<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redefinir Senha | Metalurgia Futurística Admin</title>
    
    <!-- FAVICON -->
    <link rel="icon" type="image/png" href="/images/favicon.png">

    <!-- FONTES E ICONES -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- CSS FRAMEWORK -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- ESTILO BASE -->
    <link rel="stylesheet" href="/css/style.css">

    <style>
        body {
            background: radial-gradient(circle at center, #111 0%, #000 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            padding: 20px;
        }

        .reset-container {
            width: 100%;
            max-width: 450px;
        }

        .reset-card {
            background: var(--bg-dark-2);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-xl);
            padding: 3rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            position: relative;
            z-index: 10;
        }

        .reset-header {
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .reset-logo {
            height: 50px;
            margin-bottom: 1.5rem;
            filter: drop-shadow(0 0 10px var(--primary-glow));
        }

        .reset-header h1 {
            font-size: 1.25rem;
            font-weight: 800;
            letter-spacing: 1px;
            color: #fff;
            margin-bottom: 0.5rem;
        }

        .reset-header p {
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        /* Form Estilos */
        .form-group-custom {
            margin-bottom: 1.5rem;
            position: relative;
        }

        .form-group-custom i {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
        }

        .form-control-admin {
            width: 100%;
            padding: 0.85rem 1rem 0.85rem 3rem;
            background: var(--bg-dark);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            color: #fff;
            font-size: 0.95rem;
            transition: all 0.3s;
        }

        .form-control-admin:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 15px var(--primary-glow);
        }

        .btn-reset {
            width: 100%;
            padding: 0.85rem;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border: none;
            border-radius: var(--radius-md);
            color: #000;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 1rem;
        }

        .btn-reset:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px var(--primary-glow-strong);
        }

        /* Engrenagens de Fundo */
        .bg-gear {
            position: absolute;
            color: rgba(255,255,255,0.02);
            z-index: 1;
            pointer-events: none;
        }
        .gear-1 { font-size: 20rem; top: -10%; left: -10%; animation: rotateGear 20s linear infinite; }
        
        @keyframes rotateGear {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .alert-reset {
            background: rgba(220, 53, 69, 0.1);
            border: 1px solid rgba(220, 53, 69, 0.2);
            color: #ff6b6b;
            padding: 0.75rem 1rem;
            border-radius: var(--radius-md);
            font-size: 0.85rem;
            margin-bottom: 1.5rem;
            display: none; /* Ativado via JS */
            align-items: center;
            gap: 0.75rem;
        }
    </style>
</head>
<body>

    <i class="fas fa-cog bg-gear gear-1"></i>

    <div class="reset-container">
        <div class="reset-card" data-aos="zoom-in">
            
            <div class="reset-header">
                <img src="/images/logo.png" alt="Metalurgia Logo" class="reset-logo">
                <h1 class="syncopate">NOVA SENHA</h1>
                <p>Crie uma credencial forte para sua segurança.</p>
            </div>

            <!-- Alerta de Erro de Validação -->
            <div id="error-alert" class="alert-reset">
                <i class="fas fa-exclamation-triangle"></i>
                <span id="error-message">As senhas não coincidem.</span>
            </div>

            <form id="resetForm" action="/auth/update-password" method="POST">
                
                <div class="form-group-custom">
                    <input type="password" id="password" name="password" class="form-control-admin" placeholder="Nova Senha" required minlength="8">
                    <i class="fas fa-lock"></i>
                </div>

                <div class="form-group-custom">
                    <input type="password" id="confirm_password" name="confirm_password" class="form-control-admin" placeholder="Confirme a Nova Senha" required>
                    <i class="fas fa-check-double"></i>
                </div>

                <div class="password-requirements mb-4 px-1">
                    <p class="small text-muted mb-1"><i class="fas fa-info-circle me-1"></i> Requisitos:</p>
                    <ul class="small text-muted ps-3 mb-0" style="font-size: 0.75rem;">
                        <li>Mínimo de 8 caracteres</li>
                        <li>Pelo menos uma letra maiúscula</li>
                        <li>Pelo menos um número</li>
                    </ul>
                </div>

                <button type="submit" class="btn-reset">
                    <i class="fas fa-key me-2"></i> DEFINIR NOVA SENHA
                </button>

            </form>

            <div class="text-center mt-4">
                <a href="/auth/login" class="small text-muted text-decoration-none">
                    <i class="fas fa-arrow-left me-1"></i> Voltar ao login
                </a>
            </div>

        </div>
    </div>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 1000, once: true });

        const form = document.getElementById('resetForm');
        const pass = document.getElementById('password');
        const confirmPass = document.getElementById('confirm_password');
        const errorAlert = document.getElementById('error-alert');
        const errorMsg = document.getElementById('error-message');

        form.addEventListener('submit', function(e) {
            // 1. Validar Igualdade
            if (pass.value !== confirmPass.value) {
                e.preventDefault();
                errorMsg.innerText = "As senhas digitadas não coincidem.";
                errorAlert.style.display = 'flex';
                return;
            }

            // 2. Validar Complexidade (Letra Maiúscula e Número)
            const regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/;
            if (!regex.test(pass.value)) {
                e.preventDefault();
                errorMsg.innerText = "A senha não atende aos requisitos de segurança.";
                errorAlert.style.display = 'flex';
                return;
            }

            // Se passar, o formulário segue para o backend que processa com Supabase
            const btn = form.querySelector('button');
            btn.innerHTML = '<i class="fas fa-circle-notch fa-spin me-2"></i> PROCESSANDO...';
            btn.disabled = true;
        });

        // Esconde erro ao começar a digitar novamente
        [pass, confirmPass].forEach(input => {
            input.addEventListener('input', () => {
                errorAlert.style.display = 'none';
            });
        });
    </script>
</body>
</html>