<!-- 
    ADMIN/LEADS/INDEX.EJS - GESTÃO DE MENSAGENS DE CONTATO
    Metalurgia Futurística Leonardo Serra 
-->

<div class="container-fluid p-0">

    <!-- Cabeçalho da Página -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Leads e Contatos</h2>
            <p class="text-muted">Acompanhe as solicitações de orçamento recebidas pelo site.</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-danger p-2"><%= leads.filter(l => !l.is_read).length %> Novos</span>
            <span class="badge bg-secondary p-2"><%= leads.length %> Total</span>
        </div>
    </div>

    <!-- Tabela de Mensagens -->
    <div class="card bg-dark-2 border-secondary shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="table-light text-dark">
                        <tr>
                            <th class="ps-4">Status</th>
                            <th>Remetente</th>
                            <th>E-mail / Telefone</th>
                            <th>Mensagem (Prévia)</th>
                            <th>Data</th>
                            <th class="text-center pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (leads && leads.length > 0) { %>
                            <% leads.forEach(lead => { %>
                                <tr class="lead-row <%= lead.is_read ? 'read opacity-75' : 'unread fw-bold' %>" id="row-<%= lead.id %>">
                                    <!-- Status Visual -->
                                    <td class="ps-4">
                                        <% if (!lead.is_read) { %>
                                            <span class="status-dot pulse bg-danger" title="Não Lido"></span>
                                        <% } else { %>
                                            <span class="status-dot bg-secondary" title="Lido"></span>
                                        <% } %>
                                    </td>

                                    <!-- Nome e Empresa -->
                                    <td>
                                        <div class="text-white"><%= lead.name %></div>
                                        <div class="small text-muted"><%= lead.subject || 'Interesse Geral' %></div>
                                    </td>

                                    <!-- Contatos -->
                                    <td>
                                        <div class="small"><i class="far fa-envelope me-2"></i><%= lead.email %></div>
                                        <div class="small"><i class="fas fa-phone-alt me-2"></i><%= lead.phone || 'Não informado' %></div>
                                    </td>

                                    <!-- Conteúdo (Truncado) -->
                                    <td style="max-width: 300px;">
                                        <div class="text-truncate small text-secondary">
                                            <%= lead.message %>
                                        </div>
                                    </td>

                                    <!-- Data -->
                                    <td>
                                        <span class="small">
                                            <%= helpers.formatDateShort(lead.created_at) %>
                                        </span>
                                    </td>

                                    <!-- Ações -->
                                    <td class="text-center pe-4">
                                        <div class="btn-group">
                                            <!-- Botão de Ver Detalhes (Modal) -->
                                            <button class="btn btn-sm btn-primary" 
                                                    onclick="viewLeadDetails('<%= JSON.stringify(lead) %>')"
                                                    title="Ler Mensagem Completa">
                                                <i class="fas fa-envelope-open"></i>
                                            </button>
                                            
                                            <!-- Botão Excluir -->
                                            <form action="/admin/leads/delete/<%= lead.id %>" method="POST" class="d-inline">
                                                <button type="submit" 
                                                        class="btn btn-sm btn-outline-danger btn-delete-confirm"
                                                        data-confirm-message="Deseja excluir este contato permanentemente?"
                                                        title="Excluir Contato">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="opacity-25 mb-3">
                                        <i class="fas fa-inbox fa-4x"></i>
                                    </div>
                                    <h5 class="text-muted">Nenhuma mensagem recebida.</h5>
                                    <p class="small text-muted">Quando os clientes preencherem o formulário, as mensagens aparecerão aqui.</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ==================== MODAL DE DETALHES DO LEAD ==================== -->
<div class="modal fade" id="leadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark-2 border-secondary text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold" id="leadModalTitle">Mensagem de Contato</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-4">
                    <label class="small text-primary fw-bold text-uppercase">De:</label>
                    <div id="leadModalName" class="fs-5 fw-bold"></div>
                    <div id="leadModalContact" class="text-muted"></div>
                </div>
                <div class="mb-4">
                    <label class="small text-primary fw-bold text-uppercase">Data de Recebimento:</label>
                    <div id="leadModalDate" class="text-white"></div>
                </div>
                <div class="mb-3">
                    <label class="small text-primary fw-bold text-uppercase">Mensagem:</label>
                    <div class="p-3 bg-dark rounded border border-secondary" id="leadModalMessage" style="white-space: pre-wrap; line-height: 1.6;">
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <a href="" id="leadModalWhatsApp" target="_blank" class="btn btn-success">
                    <i class="fab fa-whatsapp me-2"></i> RESPONDER WHATSAPP
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">FECHAR</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilos de Status de Lead */
    .status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: block;
    }
    
    .status-dot.pulse {
        box-shadow: 0 0 0 rgba(220, 53, 69, 0.4);
        animation: pulse-red 2s infinite;
    }

    @keyframes pulse-red {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(220, 53, 69, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
    }

    .lead-row.unread { background-color: rgba(var(--primary-rgb), 0.05); }
    .lead-row.read { opacity: 0.6; }
    
    .table-dark { --bs-table-bg: transparent; }
    .table > :not(caption) > * > * { padding: 1rem 0.5rem; }
</style>

<script>
    /**
     * Função para abrir o modal e preencher os dados do lead
     */
    function viewLeadDetails(leadJson) {
        const lead = JSON.parse(leadJson);
        const modal = new bootstrap.Modal(document.getElementById('leadModal'));
        
        document.getElementById('leadModalName').innerText = lead.name;
        document.getElementById('leadModalContact').innerText = `${lead.email} | ${lead.phone || 'Sem telefone'}`;
        document.getElementById('leadModalDate').innerText = new Date(lead.created_at).toLocaleString('pt-BR');
        document.getElementById('leadModalMessage').innerText = lead.message;

        // Gerar link de resposta WhatsApp se houver telefone
        const waBtn = document.getElementById('leadModalWhatsApp');
        if (lead.phone) {
            const cleanPhone = lead.phone.replace(/\D/g, '');
            const msg = encodeURIComponent(`Olá ${lead.name}, recebemos sua mensagem através do nosso site e gostaríamos de prosseguir com seu atendimento.`);
            waBtn.href = `https://wa.me/${cleanPhone.startsWith('244') ? cleanPhone : '244' + cleanPhone}?text=${msg}`;
            waBtn.style.display = 'inline-flex';
        } else {
            waBtn.style.display = 'none';
        }

        modal.show();

        // Se o lead não estiver lido, envia requisição AJAX para marcar como lido
        if (!lead.is_read) {
            fetch(`/admin/leads/read/${lead.id}`, { method: 'POST' })
                .then(res => {
                    if (res.ok) {
                        const row = document.getElementById(`row-${lead.id}`);
                        row.classList.remove('unread', 'fw-bold');
                        row.classList.add('read');
                        row.querySelector('.status-dot').classList.remove('pulse', 'bg-danger');
                        row.querySelector('.status-dot').classList.add('bg-secondary');
                    }
                });
        }
    }
</script>