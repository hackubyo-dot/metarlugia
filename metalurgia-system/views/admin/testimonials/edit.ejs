<!-- 
    ADMIN/TESTIMONIALS/EDIT.EJS - ALTERAR DEPOIMENTO EXISTENTE
    Metalurgia Futurística Leonardo Serra 
-->

<div class="container-fluid p-0">

    <!-- Cabeçalho de Navegação -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/admin/testimonials" class="text-primary text-decoration-none">Depoimentos</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">Editar Depoimento</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0">Alterar Recomendação</h2>
        </div>
        <a href="/admin/testimonials" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i> VOLTAR
        </a>
    </div>

    <form action="/admin/testimonials/update/<%= testimonial.id %>" method="POST" enctype="multipart/form-data" id="testimonialEditForm">
        <div class="row">
            
            <!-- Coluna Principal: Conteúdo -->
            <div class="col-xl-8">
                <div class="card bg-dark-2 border-secondary shadow-sm mb-4">
                    <div class="card-header bg-transparent border-secondary py-3 d-flex justify-content-between">
                        <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-quote-left me-2"></i>Conteúdo do Relato</h5>
                        <span class="badge bg-dark border border-secondary text-muted">ID: <%= testimonial.id.substring(0,8) %></span>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <!-- Nome do Cliente -->
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Nome do Cliente</label>
                                <input type="text" name="name" class="form-control bg-dark border-secondary text-white" 
                                       value="<%= testimonial.name %>" required>
                            </div>

                            <!-- Cargo e Empresa -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Cargo / Função</label>
                                <input type="text" name="role" class="form-control bg-dark border-secondary text-white" 
                                       value="<%= testimonial.role %>" placeholder="Ex: Diretor">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Empresa</label>
                                <input type="text" name="company" class="form-control bg-dark border-secondary text-white" 
                                       value="<%= testimonial.company %>" placeholder="Ex: Construtora">
                            </div>

                            <!-- O Depoimento -->
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Texto do Depoimento</label>
                                <textarea name="content" class="form-control bg-dark border-secondary text-white" rows="6" 
                                          required><%= testimonial.content %></textarea>
                            </div>

                            <!-- Avaliação por Estrelas -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Avaliação (1 a 5 Estrelas)</label>
                                <div class="rating-select-container p-3 bg-dark rounded border border-secondary d-flex justify-content-between align-items-center">
                                    <div class="stars-input" id="star_rating_input">
                                        <% for(let i=1; i <= 5; i++) { %>
                                            <i class="<%= i <= testimonial.rating ? 'fas' : 'far' %> fa-star text-warning cursor-pointer" data-value="<%= i %>"></i>
                                        <% } %>
                                    </div>
                                    <input type="hidden" name="rating" id="rating_value" value="<%= testimonial.rating %>">
                                    <span class="badge bg-primary" id="rating_label"><%= testimonial.rating %> Estrelas</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Coluna Lateral: Foto e Ações -->
            <div class="col-xl-4">
                
                <!-- Card de Foto -->
                <div class="card bg-dark-2 border-secondary shadow-sm mb-4">
                    <div class="card-header bg-transparent border-secondary py-3 text-center">
                        <h6 class="mb-0 fw-bold text-primary">Foto do Cliente</h6>
                    </div>
                    <div class="card-body text-center">
                        <div id="photo_preview_box" class="testimonial-preview-avatar mb-3">
                            <% if (testimonial.photo_url) { %>
                                <img src="<%= testimonial.photo_url %>" alt="Foto Atual" id="current_photo_img">
                            <% } else { %>
                                <i class="fas fa-user fa-3x text-muted opacity-25"></i>
                            <% } %>
                        </div>
                        <label class="btn btn-dark border-secondary w-100 py-2 mb-2">
                            <i class="fas fa-camera me-2"></i> TROCAR FOTO
                            <input type="file" name="photo_file" id="photo_input" class="hidden" accept="image/*">
                        </label>
                        <p class="small text-muted mb-0">Deixe vazio para manter a foto atual.</p>
                    </div>
                </div>

                <!-- Botões de Ação -->
                <div class="card bg-dark-2 border-secondary shadow-sm">
                    <div class="card-body">
                        <button type="submit" class="btn btn-primary w-100 mb-2 py-2 fw-bold">
                            <i class="fas fa-sync-alt me-2"></i> SALVAR ALTERAÇÕES
                        </button>
                        <a href="/admin/testimonials" class="btn btn-outline-secondary w-100">CANCELAR</a>
                    </div>
                </div>

                <!-- Info Adicional -->
                <div class="mt-4 p-3 bg-dark-3 rounded border border-secondary small text-muted">
                    <i class="fas fa-info-circle me-2 text-info"></i>
                    Cadastrado em: <%= helpers.formatDate(testimonial.created_at) %>
                </div>

            </div>
        </div>
    </form>
</div>

<style>
    /* Estilos de Preview de Avatar */
    .testimonial-preview-avatar {
        width: 120px;
        height: 120px;
        background: var(--bg-dark);
        border: 2px solid var(--border-color);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        overflow: hidden;
    }

    .testimonial-preview-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Seletor de Estrelas */
    .stars-input i {
        font-size: 1.5rem;
        transition: transform 0.2s;
        margin-right: 5px;
    }

    .stars-input i:hover {
        transform: scale(1.2);
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .form-control:focus {
        border-color: var(--primary);
        box-shadow: 0 0 10px rgba(var(--primary-rgb), 0.1);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // 1. Preview de Nova Foto
        const photoInput = document.getElementById('photo_input');
        const currentPhotoImg = document.getElementById('current_photo_img');
        const previewBox = document.getElementById('photo_preview_box');

        photoInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    if (currentPhotoImg) {
                        currentPhotoImg.src = e.target.result;
                    } else {
                        previewBox.innerHTML = `<img src="${e.target.result}" alt="Nova Foto">`;
                    }
                }
                reader.readAsDataURL(file);
            }
        });

        // 2. Lógica do Seletor de Estrelas
        const stars = document.querySelectorAll('#star_rating_input i');
        const ratingInput = document.getElementById('rating_value');
        const ratingLabel = document.getElementById('rating_label');

        stars.forEach(star => {
            star.addEventListener('click', function() {
                const val = parseInt(this.getAttribute('data-value'));
                ratingInput.value = val;
                ratingLabel.innerText = `${val} Estrelas`;
                
                // Atualiza visual das estrelas (cheias vs vazias)
                stars.forEach((s, index) => {
                    if (index < val) {
                        s.classList.remove('far');
                        s.classList.add('fas');
                    } else {
                        s.classList.remove('fas');
                        s.classList.add('far');
                    }
                });
            });
        });
    });
</script>