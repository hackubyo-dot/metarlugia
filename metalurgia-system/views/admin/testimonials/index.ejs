<!-- 
    ADMIN/TESTIMONIALS/INDEX.EJS - GESTÃO DE DEPOIMENTOS E PROVA SOCIAL
    Metalurgia Futurística Leonardo Serra 
-->

<div class="container-fluid p-0">

    <!-- Cabeçalho da Página -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Depoimentos</h2>
            <p class="text-muted">Gerencie o que os clientes dizem sobre a Metalurgia Futurística.</p>
        </div>
        <a href="/admin/testimonials/create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i> NOVO DEPOIMENTO
        </a>
    </div>

    <!-- Tabela de Depoimentos -->
    <div class="card bg-dark-2 border-secondary shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="table-light text-dark">
                        <tr>
                            <th class="ps-4">Cliente</th>
                            <th>Empresa / Cargo</th>
                            <th>Depoimento (Prévia)</th>
                            <th class="text-center">Avaliação</th>
                            <th class="text-center pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (testimonials && testimonials.length > 0) { %>
                            <% testimonials.forEach(test => { %>
                                <tr>
                                    <!-- Foto e Nome do Cliente -->
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="testimonial-avatar-mini me-3">
                                                <img src="<%= test.photo_url || '/images/logo.png' %>" alt="<%= test.name %>">
                                            </div>
                                            <div>
                                                <div class="fw-bold text-white"><%= test.name %></div>
                                                <div class="small text-muted"><%= helpers.formatDateShort(test.created_at) %></div>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Empresa e Cargo -->
                                    <td>
                                        <div class="small text-white fw-bold"><%= test.company || 'Cliente Individual' %></div>
                                        <div class="small text-muted"><%= test.role || 'Proprietário' %></div>
                                    </td>

                                    <!-- Conteúdo Truncado -->
                                    <td style="max-width: 350px;">
                                        <div class="small text-secondary text-truncate" title="<%= test.content %>">
                                            "<%= test.content %>"
                                        </div>
                                    </td>

                                    <!-- Avaliação por Estrelas -->
                                    <td class="text-center">
                                        <div class="text-warning small">
                                            <% for(let i=0; i < (test.rating || 5); i++) { %>
                                                <i class="fas fa-star"></i>
                                            <% } %>
                                        </div>
                                    </td>

                                    <!-- Ações -->
                                    <td class="text-center pe-4">
                                        <div class="btn-group">
                                            <a href="/admin/testimonials/edit/<%= test.id %>" class="btn btn-sm btn-outline-info" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form action="/admin/testimonials/delete/<%= test.id %>" method="POST" class="d-inline">
                                                <button type="submit" 
                                                        class="btn btn-sm btn-outline-danger btn-delete-confirm"
                                                        data-confirm-message="Deseja remover este depoimento? Esta ação é irreversível."
                                                        title="Excluir">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="opacity-25 mb-3">
                                        <i class="fas fa-quote-left fa-4x"></i>
                                    </div>
                                    <h5 class="text-muted">Nenhum depoimento registrado.</h5>
                                    <p class="small text-muted">Peça uma recomendação aos seus clientes satisfeitos e cadastre-a aqui.</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Informativo de Branding -->
    <div class="mt-4 row">
        <div class="col-md-8">
            <div class="alert bg-dark-3 border-secondary d-flex align-items-center mb-0">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                    <i class="fas fa-certificate text-primary"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-white mb-1">A importância da Prova Social</h6>
                    <p class="small text-muted mb-0">Exibir depoimentos reais de empresas conhecidas em Angola aumenta em até 40% as chances de fechamento de novos orçamentos industriais.</p>
                </div>
            </div>
        </div>
    </div>

</div>

<style>
    /* Estilos específicos para avatares na tabela */
    .testimonial-avatar-mini {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid var(--border-color);
        background: var(--bg-dark);
    }

    .testimonial-avatar-mini img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .table > :not(caption) > * > * {
        padding: 1.1rem 0.5rem;
    }

    .btn-group .btn {
        padding: 0.4rem 0.75rem;
    }

    tr:hover .testimonial-avatar-mini {
        border-color: var(--primary);
        transform: scale(1.05);
        transition: all 0.3s;
    }
</style>