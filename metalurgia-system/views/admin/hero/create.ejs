<div class="container-fluid p-0">

    <!-- Cabeçalho de Navegação -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/admin/hero" class="text-primary text-decoration-none">Hero Slider</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">Novo Slide</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0">Adicionar Slide</h2>
        </div>
        <a href="/admin/hero" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i> VOLTAR
        </a>
    </div>

    <div class="row">
        <!-- Coluna do Formulário -->
        <div class="col-xl-8">
            <div class="card bg-dark-2 border-secondary shadow-sm">
                <div class="card-body p-4">
                    <form action="/admin/hero/store" method="POST" enctype="multipart/form-data" id="heroForm">
                        
                        <div class="row g-4">
                            <!-- Título Principal -->
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Título do Slide</label>
                                <input type="text" name="title" class="form-control bg-dark border-secondary text-white" 
                                       placeholder="Ex: O poder do aço" required>
                                <div class="form-text text-muted">Aparecerá em destaque no centro do slide.</div>
                            </div>

                            <!-- Subtítulo / Badge -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Subtítulo (Badge)</label>
                                <input type="text" name="subtitle" class="form-control bg-dark border-secondary text-white" 
                                       placeholder="Ex: EXCELÊNCIA EM AÇO">
                            </div>

                            <!-- Ordem de Exibição -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Ordem de Exibição</label>
                                <input type="number" name="display_order" class="form-control bg-dark border-secondary text-white" 
                                       value="0" min="0">
                            </div>

                            <!-- Descrição Curta -->
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Descrição</label>
                                <textarea name="description" class="form-control bg-dark border-secondary text-white" rows="2" 
                                          placeholder="Líderes em engenharia de precisão."></textarea>
                            </div>

                            <!-- Botão: Texto e Link -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Texto do Botão</label>
                                <input type="text" name="button_text" class="form-control bg-dark border-secondary text-white" 
                                       placeholder="Ex: EXPLORAR SOLUÇÕES">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Link do Botão</label>
                                <input type="text" name="button_link" class="form-control bg-dark border-secondary text-white" 
                                       placeholder="Ex: #servicos">
                            </div>

                            <!-- Configuração de Mídia -->
                            <div class="col-md-12 pt-3 border-top border-secondary mt-4">
                                <h5 class="fw-bold mb-3"><i class="fas fa-photo-video me-2 text-primary"></i>Mídia do Slide</h5>
                                
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Tipo de Mídia</label>
                                        <select name="media_type" id="media_type" class="form-select bg-dark border-secondary text-white">
                                            <option value="image">Imagem Estática</option>
                                            <option value="video">Vídeo (MP4)</option>
                                        </select>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label fw-bold">Arquivo de Mídia</label>
                                        <input type="file" name="media_file" id="media_file" class="form-control bg-dark border-secondary text-white" 
                                               accept="image/*,video/mp4" required>
                                        <div class="form-text text-muted">Tamanho máximo recomendado: 10MB.</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Botões de Ação -->
                            <div class="col-md-12 pt-4">
                                <button type="submit" class="btn btn-primary px-5 py-2">
                                    <i class="fas fa-save me-2"></i> SALVAR SLIDE
                                </button>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>

        <!-- Coluna de Preview Lateral -->
        <div class="col-xl-4 mt-4 mt-xl-0">
            <div class="card bg-dark-2 border-secondary shadow-sm sticky-top" style="top: 100px;">
                <div class="card-header bg-transparent border-secondary py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-eye me-2 text-info"></i>Pré-visualização</h5>
                </div>
                <div class="card-body">
                    <!-- Simulador do Slide na Home -->
                    <div class="preview-hero-box shadow-lg">
                        <div id="media_preview" class="media-placeholder">
                            <i class="fas fa-cloud-upload-alt fa-3x mb-2"></i>
                            <p class="small mb-0">Selecione um arquivo para pré-visualizar</p>
                        </div>
                        <div class="preview-overlay">
                            <div class="preview-badge" id="preview_subtitle">Badge</div>
                            <h4 class="preview-title" id="preview_title">Título do Slide</h4>
                            <a href="#" class="preview-btn" id="preview_button">Botão</a>
                        </div>
                    </div>

                    <div class="mt-4 p-3 bg-dark-3 rounded border border-secondary">
                        <p class="small text-muted mb-0">
                            <i class="fas fa-lightbulb text-warning me-2"></i>
                            <strong>Nota:</strong> O preview acima é uma simulação aproximada de como o slide aparecerá na página inicial.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<style>
    /* Estilos específicos para o formulário de criação */
    .preview-hero-box {
        position: relative;
        width: 100%;
        aspect-ratio: 16/9;
        background: #000;
        border-radius: 12px;
        overflow: hidden;
        border: 2px solid var(--border-color);
    }

    .media-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: var(--text-muted);
        text-align: center;
        padding: 20px;
    }

    .preview-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.5);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 20px;
        z-index: 2;
    }

    .preview-badge {
        font-size: 0.5rem;
        color: var(--primary);
        font-weight: 900;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .preview-title {
        font-size: 1rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 10px;
        text-align: center;
    }

    .preview-btn {
        font-size: 0.6rem;
        padding: 5px 12px;
        background: var(--primary);
        color: #000;
        border-radius: 4px;
        font-weight: 800;
        text-decoration: none;
    }

    .preview-img, .preview-video {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        object-fit: cover;
        z-index: 1;
    }
</style>

<script>
    /**
     * Script de Live Preview para o Slide
     */
    document.addEventListener('DOMContentLoaded', () => {
        const fileInput = document.getElementById('media_file');
        const mediaPreview = document.getElementById('media_preview');
        const typeSelect = document.getElementById('media_type');
        
        // Sincronização de Textos
        const inputTitle = document.querySelector('input[name="title"]');
        const inputSubtitle = document.querySelector('input[name="subtitle"]');
        const inputButton = document.querySelector('input[name="button_text"]');

        inputTitle.addEventListener('input', e => document.getElementById('preview_title').innerText = e.target.value || 'Título do Slide');
        inputSubtitle.addEventListener('input', e => document.getElementById('preview_subtitle').innerText = e.target.value || 'Badge');
        inputButton.addEventListener('input', e => document.getElementById('preview_button').innerText = e.target.value || 'Botão');

        // Lógica de Preview de Arquivo
        fileInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                const type = typeSelect.value;

                reader.onload = function(e) {
                    mediaPreview.innerHTML = '';
                    if (type === 'image') {
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        img.className = 'preview-img';
                        mediaPreview.appendChild(img);
                    } else {
                        const video = document.createElement('video');
                        video.src = e.target.result;
                        video.className = 'preview-video';
                        video.autoplay = true;
                        video.muted = true;
                        video.loop = true;
                        mediaPreview.appendChild(video);
                    }
                }
                reader.readAsDataURL(file);
            }
        });

        // Alerta sobre mudança de tipo após seleção de arquivo
        typeSelect.addEventListener('change', () => {
            if (fileInput.value) {
                alert('O tipo de mídia mudou. Por favor, selecione o arquivo novamente para atualizar o preview.');
                fileInput.value = '';
                mediaPreview.innerHTML = '<div class="media-placeholder"><i class="fas fa-cloud-upload-alt fa-3x mb-2"></i><p class="small mb-0">Selecione um arquivo para pré-visualizar</p></div>';
            }
        });
    });
</script>