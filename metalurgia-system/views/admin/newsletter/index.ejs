<!-- 
    ADMIN/NEWSLETTER/INDEX.EJS - GESTÃO DE INSCRITOS
    Metalurgia Futurística Leonardo Serra 
-->

<div class="container-fluid p-0">

    <!-- Cabeçalho da Página -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Newsletter</h2>
            <p class="text-muted">Lista de e-mails capturados para marketing e novidades.</p>
        </div>
        <div class="d-flex gap-3">
            <!-- Estatística Rápida -->
            <div class="bg-dark-2 border border-secondary rounded px-4 py-2 text-center">
                <div class="small text-muted text-uppercase fw-bold" style="font-size: 0.6rem;">Total de Inscritos</div>
                <div class="h4 mb-0 fw-bold text-primary"><%= subscribers.length %></div>
            </div>
            
            <!-- Botão de Exportação (Funcionalidade para o Futuro) -->
            <button class="btn btn-outline-success d-flex align-items-center" onclick="alert('Funcionalidade de exportação CSV em desenvolvimento.')">
                <i class="fas fa-file-excel me-2"></i> EXPORTAR LISTA
            </button>
        </div>
    </div>

    <!-- Tabela de Inscritos -->
    <div class="card bg-dark-2 border-secondary shadow-sm">
        <div class="card-header bg-transparent border-secondary py-3">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-users me-2 text-primary"></i>Base de E-mails</h5>
                </div>
                <div class="col-auto">
                    <div class="input-group input-group-sm" style="width: 250px;">
                        <span class="input-group-text bg-dark border-secondary text-muted"><i class="fas fa-search"></i></span>
                        <input type="text" id="newsSearch" class="form-control bg-dark border-secondary text-white" placeholder="Buscar e-mail...">
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0" id="subscribersTable">
                    <thead class="table-light text-dark">
                        <tr>
                            <th class="ps-4" style="width: 80px;">#</th>
                            <th>Endereço de E-mail</th>
                            <th>Data de Inscrição</th>
                            <th>Status</th>
                            <th class="text-center pe-4" style="width: 150px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (subscribers && subscribers.length > 0) { %>
                            <% subscribers.forEach((sub, index) => { %>
                                <tr>
                                    <!-- Índice -->
                                    <td class="ps-4">
                                        <span class="text-muted"><%= index + 1 %></span>
                                    </td>

                                    <!-- E-mail -->
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary text-dark rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                                                <i class="fas fa-at"></i>
                                            </div>
                                            <span class="fw-bold text-white"><%= sub.email %></span>
                                        </div>
                                    </td>

                                    <!-- Data -->
                                    <td>
                                        <span class="text-secondary small">
                                            <i class="far fa-calendar-alt me-2"></i><%= helpers.formatDate(sub.created_at) %>
                                        </span>
                                    </td>

                                    <!-- Status -->
                                    <td>
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3">
                                            Confirmado
                                        </span>
                                    </td>

                                    <!-- Ação de Exclusão -->
                                    <td class="text-center pe-4">
                                        <form action="/admin/newsletter/delete/<%= sub.id %>" method="POST" class="d-inline">
                                            <button type="submit" 
                                                    class="btn btn-sm btn-outline-danger btn-delete-confirm"
                                                    data-confirm-message="Deseja remover este e-mail da lista? Ele não receberá mais comunicações automáticas."
                                                    title="Remover Assinante">
                                                <i class="fas fa-user-minus me-2"></i>REMOVER
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="opacity-25 mb-3">
                                        <i class="fas fa-paper-plane fa-4x"></i>
                                    </div>
                                    <h5 class="text-muted">Nenhum assinante capturado.</h5>
                                    <p class="small text-muted">Aguarde os visitantes preencherem o formulário no rodapé do site.</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Card de Aviso Legal / Dica -->
    <div class="mt-4 p-4 bg-dark-3 border border-secondary rounded-3">
        <div class="row align-items-center">
            <div class="col-auto">
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                    <i class="fas fa-shield-alt text-warning fa-lg"></i>
                </div>
            </div>
            <div class="col">
                <h6 class="fw-bold mb-1">Privacidade e Dados (LGPD)</h6>
                <p class="small text-muted mb-0">
                    Certifique-se de utilizar estes e-mails apenas para comunicações autorizadas pela **Metalurgia Futurística**. Não compartilhe esta base de dados com terceiros.
                </p>
            </div>
        </div>
    </div>

</div>

<style>
    /* Estilos para a tabela de Newsletter */
    .table-dark {
        --bs-table-bg: transparent;
    }
    
    .table > :not(caption) > * > * {
        padding: 1.2rem 0.5rem;
    }

    /* Efeito de busca simples via JS abaixo */
    .hidden-row {
        display: none !important;
    }
</style>

<script>
    /**
     * Filtro de busca simples na tabela
     */
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('newsSearch');
        const tableRows = document.querySelectorAll('#subscribersTable tbody tr');

        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                const term = e.target.value.toLowerCase();

                tableRows.forEach(row => {
                    const email = row.querySelector('td:nth-child(2)').textContent.toLowerCase();
                    if (email.includes(term)) {
                        row.classList.remove('hidden-row');
                    } else {
                        row.classList.add('hidden-row');
                    }
                });
            });
        }
    });
</script>