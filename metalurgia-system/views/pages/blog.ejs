<!-- 
    BLOG.EJS - PORTAL DE NOTÍCIAS E ARTIGOS TÉCNICOS
    Metalurgia Futurística Leonardo Serra 
-->

<section class="blog-section">
    <!-- Cabeçalho da Página -->
    <div class="blog-single-header" style="padding: 120px 0 60px;">
        <div class="container">
            <div class="section-tag" data-aos="fade-up">
                <span class="tag-dot"></span>
                CONHECIMENTO TÉCNICO
            </div>
            <h1 class="blog-single-title syncopate" data-aos="fade-up" data-aos-delay="100">
                BLOG <span class="text-gradient">INDUSTRIAL</span>
            </h1>
            <p class="section-subtitle mx-auto" data-aos="fade-up" data-aos-delay="200">
                Acompanhe as últimas tendências em engenharia de aço, inovações em corte CNC e as novidades da Metalurgia Futurística.
            </p>
        </div>
    </div>

    <div class="container pb-5">
        <div class="blog-grid">
            <% if (posts && posts.length > 0) { %>
                <% posts.forEach((post, index) => { %>
                    <!-- Card de Artigo -->
                    <article class="blog-card" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
                        <div class="blog-card-image">
                            <!-- Link para o artigo na imagem -->
                            <a href="/blog/<%= post.slug %>">
                                <img src="<%= post.thumb_url || '/images/blog-default.jpg' %>" alt="<%= post.title %>" loading="lazy">
                            </a>
                            <!-- Badge de Categoria -->
                            <span class="blog-category-badge">
                                <%= post.category || 'Inovação' %>
                            </span>
                        </div>

                        <div class="blog-card-content">
                            <!-- Data e Autor -->
                            <div class="blog-card-date">
                                <i class="far fa-calendar-alt me-1"></i>
                                <%= helpers.formatDateShort(post.published_at) %>
                                <span class="mx-2">|</span>
                                <i class="far fa-user me-1"></i>
                                <%= helpers.authorName(post.author) %>
                            </div>

                            <!-- Título do Post -->
                            <h2 class="blog-card-title">
                                <a href="/blog/<%= post.slug %>"><%= post.title %></a>
                            </h2>

                            <!-- Resumo (Truncado pelo helper) -->
                            <p class="blog-card-excerpt">
                                <%= post.excerpt || helpers.truncate(post.content, 120) %>
                            </p>

                            <!-- Link de Ação -->
                            <a href="/blog/<%= post.slug %>" class="blog-card-link">
                                LER ARTIGO COMPLETO <i class="fas fa-chevron-right"></i>
                            </a>
                        </div>
                    </article>
                <% }); %>
            <% } else { %>
                <!-- Estado Vazio (Caso não existam posts) -->
                <div class="col-12 text-center py-5" data-aos="fade-up">
                    <div class="empty-blog-icon mb-4">
                        <i class="fas fa-feather-alt fa-3x" style="color: var(--border-color-2);"></i>
                    </div>
                    <h3>Nenhum artigo publicado ainda</h3>
                    <p class="text-secondary">Estamos preparando conteúdos incríveis para você. Volte em breve!</p>
                    <a href="/" class="btn-outline mt-3">VOLTAR PARA A HOME</a>
                </div>
            <% } %>
        </div>

        <!-- Paginação (Placeholder para expansão futura) -->
        <% if (posts && posts.length > 9) { %>
            <div class="row mt-5">
                <div class="col-12 d-flex justify-content-center">
                    <nav aria-label="Navegação de posts">
                        <ul class="pagination">
                            <li class="page-item disabled"><a class="page-link" href="#"><i class="fas fa-arrow-left"></i></a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#"><i class="fas fa-arrow-right"></i></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        <% } %>
    </div>
</section>

<style>
    /* Estilos locais para refinamento da página de listagem */
    .pagination {
        gap: 10px;
    }
    .page-link {
        background: var(--bg-elevated);
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-sm) !important;
        font-weight: 700;
        transition: all 0.3s;
    }
    .page-link:hover {
        background: var(--primary);
        color: #000;
        border-color: var(--primary);
    }
    .page-item.active .page-link {
        background: var(--primary);
        color: #000;
        border-color: var(--primary);
    }
    .empty-blog-icon {
        opacity: 0.5;
    }
</style>