<!-- 
    HOME.EJS - LANDING PAGE DINÂMICA (FULL VERSION)
    Metalurgia Futurística Leonardo Serra 
    Versão: 1.0.6 - Estável e Sincronizada
-->

<div class="home-page">

    <!-- ==================== HERO SECTION (DINÂMICO) ==================== -->
    <section class="hero" id="home">
        <div class="hero-slider swiper" id="heroSlider">
            <div class="swiper-wrapper">
                <% if (heroSlides && heroSlides.length > 0) { %>
                    <% heroSlides.forEach((slide, index) => { %>
                        <div class="swiper-slide">
                            <div class="hero-slide">
                                <% if (helpers.isMediaVideo(slide.media_url)) { %>
                                    <video autoplay muted loop playsinline class="hero-video">
                                        <source src="<%= slide.media_url %>" type="video/mp4">
                                    </video>
                                <% } else { %>
                                    <img src="<%= slide.media_url %>" alt="<%= slide.title %>" class="hero-video">
                                <% } %>
                                <div class="hero-overlay"></div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <!-- Fallback de Segurança caso o Banco de Dados esteja vazio -->
                    <div class="swiper-slide">
                        <div class="hero-slide">
                            <video autoplay muted loop playsinline class="hero-video">
                                <source src="/images/industrial-welding.mp4" type="video/mp4">
                            </video>
                            <div class="hero-overlay"></div>
                        </div>
                    </div>
                <% } %>
            </div>
            
            <div class="swiper-pagination"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
        </div>

        <div class="hero-content container">
            <div class="row justify-content-center">
                <div class="col-xl-10 text-center">
                    <div class="hero-text-container" data-aos="fade-up">
                        <% if (heroSlides && heroSlides.length > 0) { %>
                            <div class="hero-badge">
                                <span class="badge-line"></span>
                                <span><%= heroSlides[0].subtitle %></span>
                                <span class="badge-line"></span>
                            </div>
                            <h1 class="hero-title">
                                <span class="text-gradient"><%= heroSlides[0].title %></span>
                            </h1>
                            <p class="hero-description"><%= heroSlides[0].description %></p>
                            <div class="hero-buttons">
                                <a href="<%= heroSlides[0].button_link %>" class="btn-primary">
                                    <%= heroSlides[0].button_text %> <i class="fas fa-arrow-right"></i>
                                </a>
                                <a href="#servicos" class="btn-outline">
                                    <i class="fas fa-play"></i> TOUR INDUSTRIAL
                                </a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <div class="scroll-indicator">
            <span>SCROLL</span>
            <div class="scroll-line"></div>
        </div>
    </section>


    <!-- ==================== FEATURES OVERLAY (INSTITUCIONAL) ==================== -->
    <section class="features-overlay">
        <div class="container">
            <div class="row g-4">
                <div class="col-6 col-lg-3">
                    <div class="feature-card" data-aos="fade-up">
                        <div class="feature-card-inner">
                            <div class="feature-number">01</div>
                            <div class="feature-icon"><img src="/images/3d-gear.png" alt="Precisão CNC"></div>
                            <h3 class="feature-title">Precisão CNC</h3>
                            <p class="feature-text">Corte a plasma e laser com tolerância milimétrica absoluta.</p>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="feature-card" data-aos="fade-up" data-aos-delay="100">
                        <div class="feature-card-inner">
                            <div class="feature-number">02</div>
                            <div class="feature-icon"><img src="/images/3d-blueprint.png" alt="Cálculo Estrutural"></div>
                            <h3 class="feature-title">Cálculo Real</h3>
                            <p class="feature-text">Projetos estruturais validados por engenheiros seniores.</p>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="feature-card" data-aos="fade-up" data-aos-delay="200">
                        <div class="feature-card-inner">
                            <div class="feature-number">03</div>
                            <div class="feature-icon"><img src="/images/3d-shield.png" alt="Qualidade Elite"></div>
                            <h3 class="feature-title">Padrão Elite</h3>
                            <p class="feature-text">Soldadura certificada com garantia de durabilidade extrema.</p>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="feature-card" data-aos="fade-up" data-aos-delay="300">
                        <div class="feature-card-inner">
                            <div class="feature-number">04</div>
                            <div class="feature-icon"><img src="/images/3d-factory.png" alt="Polo Industrial"></div>
                            <h3 class="feature-title">Polo Viana</h3>
                            <p class="feature-text">Localização estratégica para logística nacional ágil.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- ==================== NOSSA HISTÓRIA (DINÂMICO) ==================== -->
    <section class="our-story" id="historia">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6" data-aos="fade-right">
                    <div class="story-visual">
                        <div class="glow-circle">
                            <div class="circle-inner">
                                <img src="<%= about.image_url || '/images/about-industrial-man.jpeg' %>" alt="Leonardo Serra">
                            </div>
                        </div>
                        <div class="floating-badge">
                            <i class="fas fa-trophy"></i>
                            <span>+<%= about.years_experience || 5 %> anos de excelência</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6" data-aos="fade-left">
                    <div class="story-content">
                        <div class="section-tag">
                            <span class="tag-dot"></span>
                            NOSSA HISTÓRIA
                        </div>
                        <h2 class="section-title">
                            <%- about.title ? about.title.replace('aço', '<span class="text-gradient">aço</span>') : 'Transformando Metais' %>
                        </h2>
                        <p class="story-text"><%= about.content %></p>
                        
                        <div class="story-cards">
                            <div class="story-card">
                                <div class="story-card-icon"><i class="fas fa-hard-hat"></i></div>
                                <div class="story-card-content">
                                    <h4>Compromisso com a Qualidade</h4>
                                    <p>Utilizamos matérias-primas certificadas e processos rigorosos de inspeção.</p>
                                </div>
                            </div>
                            <div class="story-card">
                                <div class="story-card-icon"><i class="fas fa-lightbulb"></i></div>
                                <div class="story-card-content">
                                    <h4>Inovação Constante</h4>
                                    <p>Investimos em tecnologia de ponta para automação e precisão.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- ==================== ELITE 8 MATRIX (DINÂMICO) ==================== -->
    <section class="industrial-matrix-8" id="servicos">
        <div class="container">
            <div class="row justify-content-center text-center mb-100">
                <div class="col-lg-8" data-aos="fade-up">
                    <div class="cyber-badge-modern">Criação na Prática</div>
                    <h2 class="matrix-title-ultra syncopate">DOMÍNIO <span class="text-gradient">CRIATIVO</span></h2>
                    <p class="matrix-subtitle-modern">Explore nossas 8 especialidades de elite. Clique para visualizar o processo em tempo real.</p>
                </div>
            </div>

            <div class="row g-4 matrix-grid-modern">
                <% specialties.forEach((spec, index) => { %>
                <div class="col-lg-3 col-6 matrix-col" data-aos="zoom-in" data-aos-delay="<%= index * 50 %>">
                    <div class="elite-card" onclick="openVideoModal('<%= spec.media_url %>', '<%= spec.name %>', '<%= spec.description %>')">
                        <div class="card-tag-num">0<%= index + 1 %></div>
                        <div class="card-media">
                            <img src="<%= spec.thumbnail_url || '/images/serv-2.jpeg' %>" alt="<%= spec.name %>">
                            <div class="play-hint"><i class="fas fa-play"></i></div>
                        </div>
                        <div class="card-info-modern">
                            <div class="card-icon-modern"><i class="fas <%= helpers.getIcon(spec.icon_class) %>"></i></div>
                            <h4><%= spec.name %></h4>
                            <span class="view-btn">VER PROCESSO</span>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </section>


    <!-- ==================== LISTA DE SERVIÇOS (DINÂMICO) ==================== -->
    <section class="services">
        <div class="container">
            <div class="row justify-content-center text-center mb-5">
                <div class="col-lg-8">
                    <div class="section-tag">DOMÍNIO TÉCNICO</div>
                    <h2 class="section-title">Nossas <span class="text-gradient">soluções</span> industriais</h2>
                </div>
            </div>
            <div class="row g-4">
                <% services.forEach((service, index) => { %>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="service-card" data-aos="flip-left" data-aos-delay="<%= index * 100 %>">
                        <div class="service-image">
                            <img src="<%= service.image_url %>" alt="<%= service.name %>">
                        </div>
                        <div class="service-content">
                            <h3 class="service-title"><%= service.name %></h3>
                            <p class="service-text"><%= service.description %></p>
                            <div class="service-price">A partir de <span><%= helpers.formatCurrency(service.price_start) %></span></div>
                            
                            <!-- CORREÇÃO: Index passado como número real para o JS -->
                            <button class="service-btn" onclick="openServiceModal(<%= index %>)">
                                Detalhes <i class="fas fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </section>


    <!-- ==================== CATÁLOGO TÉCNICO (DINÂMICO) ==================== -->
    <section class="catalog-download" id="download">
        <div class="catalog-download-overlay"></div>
        <div class="catalog-download-content" data-aos="zoom-in">
            <div class="catalog-download-badge">DOWNLOAD EXCLUSIVO</div>
            <h2 class="catalog-download-title"><%= catalogs.name %> <span class="text-gradient"><%= catalogs.version %></span></h2>
            <p class="catalog-download-description"><%= catalogs.description %></p>
            
            <div class="catalog-download-info">
                <div class="catalog-download-info-item">
                    <i class="fas fa-file-pdf"></i>
                    <span>PDF TÉCNICO</span>
                </div>
                <div class="catalog-download-info-item">
                    <i class="fas fa-hard-drive"></i>
                    <span><%= catalogs.file_size %></span>
                </div>
                <div class="catalog-download-info-item">
                    <i class="fas fa-chart-line"></i>
                    <span>TECH SPECS</span>
                </div>
            </div>

            <div class="catalog-download-buttons">
                <a href="<%= catalogs.pdf_url %>" download class="btn-primary">
                    <i class="fas fa-download"></i> BAIXAR CATÁLOGO
                </a>
                <a href="#contacto" class="btn-outline">SOLICITAR AMOSTRA</a>
            </div>
            <p class="catalog-download-note">
                <i class="fas fa-lock"></i> Download seguro e atualizado.
            </p>
        </div>
    </section>


    <!-- ==================== PORTFÓLIO (DINÂMICO) ==================== -->
    <section class="portfolio" id="portfolio">
        <div class="container">
            <div class="row justify-content-center text-center mb-5">
                <div class="col-lg-8">
                    <div class="section-tag">GALERIA DE PROJETOS</div>
                    <h2 class="section-title">Nossas <span class="text-gradient">obras</span> de destaque</h2>
                </div>
            </div>
            <div class="portfolio-grid">
                <% portfolio.forEach((project, index) => { %>
                <div class="portfolio-thumb" 
                     data-img="<%= project.main_image_url %>" 
                     data-title="<%= project.title %>"
                     data-client="<%= project.client %>"
                     data-aos="fade-up" 
                     data-aos-delay="<%= index * 50 %>">
                    <img src="<%= project.main_image_url %>" alt="<%= project.title %>">
                    <div class="thumb-overlay">
                        <i class="fas fa-search-plus"></i>
                        <div class="thumb-info">
                            <h4><%= project.title %></h4>
                            <span><%= project.category %></span>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </section>


    <!-- ==================== FAQ (DINÂMICO) ==================== -->
    <section class="faq" id="faq">
        <div class="container">
            <div class="row justify-content-center text-center mb-5">
                <div class="col-lg-8">
                    <div class="section-tag">DÚVIDAS FREQUENTES</div>
                    <h2 class="section-title">Perguntas <span class="text-gradient">frequentes</span></h2>
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="faq-list">
                        <% faqs.forEach((item, index) => { %>
                        <div class="faq-item" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
                            <div class="faq-question">
                                <span><%= item.question %></span>
                                <i class="fas fa-chevron-down"></i>
                            </div>
                            <div class="faq-answer">
                                <p><%= item.answer %></p>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- ==================== CONTATO ==================== -->
    <section class="contact-section" id="contacto">
        <div class="container">
            <div class="contact-header" data-aos="fade-up">
                <h2 class="contact-title">ENTRE EM CONTATO</h2>
                <p class="contact-subtitle">Estamos prontos para atender sua demanda industrial.</p>
            </div>
            <div class="contact-grid">
                <div class="contact-form-col" data-aos="fade-right">
                    <form id="contactForm" class="contact-form-new" action="/api/contact" method="POST">
                        <div class="form-row">
                            <div class="form-group"><input type="text" name="name" placeholder="Nome Completo" required></div>
                            <div class="form-group"><input type="tel" name="phone" placeholder="Telefone" required></div>
                        </div>
                        <div class="form-group"><input type="email" name="email" placeholder="E-mail profissional" required></div>
                        <div class="form-group"><textarea name="message" rows="5" placeholder="Descreva seu projeto ou necessidade..." required></textarea></div>
                        <button type="submit" class="contact-submit-btn">
                            ENVIAR MENSAGEM <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
                
                <div class="contact-info-col" data-aos="fade-left">
                    <div class="info-card">
                        <div class="info-item">
                            <div class="info-icon"><i class="fas fa-phone-alt"></i></div>
                            <div class="info-text"><h4>Telefone</h4><p>(+244) 939 717 295</p></div>
                        </div>
                        <div class="info-item">
                            <div class="info-icon"><i class="fas fa-envelope"></i></div>
                            <div class="info-text"><h4>Email</h4><p>leonardo@metalurgia.com</p></div>
                        </div>
                    </div>
                    <div class="hours-card">
                        <h3 class="syncopate">HORÁRIO COMERCIAL</h3>
                        <div class="hours-grid">
                            <div class="hours-item"><span class="day">Seg - Sex</span><span class="time">08:00 - 18:00</span></div>
                            <div class="hours-item"><span class="day">Sábado</span><span class="time">08:00 - 13:00</span></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="contact-map mt-5" data-aos="zoom-in">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126231.586770124!2d13.183333!3d-8.838333!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1a51f2e5e7f0b2d%3A0x5e7f0b2d5e7f0b2!2sLuanda%2C%20Angola!5e0!3m2!1spt!2s!4v1700000000000!5m2!1spt!2s" width="100%" height="350" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
            </div>
        </div>
    </section>

    <!-- INJEÇÃO DE DADOS CRÍTICA PARA O JS (Data Bridge) -->
    <script>
        /**
         * Transfere os dados do Backend (Node/EJS) para o Frontend (JS Global)
         * Necessário para o funcionamento dos Modais Dinâmicos.
         */
        window.SERVICES_DATA = <%- JSON.stringify(services || []) %>;
        console.log("[Bridge] Dados de serviços sincronizados com o navegador.");
    </script>
    <script>
    (function() {
        // Converte o array do servidor para um objeto que o navegador entende
        window.SERVICES_DATA = <%- JSON.stringify(services) %>;
        console.log("[System] Matriz de dados sincronizada: " + window.SERVICES_DATA.length + " serviços.");
    })();
</script>

</div> <!-- Fim .home-page -->

<!-- ==================== INCLUSÃO DE MODAIS ==================== -->
<%- include('../partials/modals/video-player') %>
<%- include('../partials/modals/service-details') %>
<%- include('../partials/modals/lightbox') %>